# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (if needed in the future)
MONGODB_URI=mongodb://localhost:27017/giftingshop

# Application Settings
APP_NAME=Gifting Shop
APP_URL=https://your-app.railway.app

# Security (add your own secret keys)
SESSION_SECRET=your-session-secret-here
JWT_SECRET=your-jwt-secret-here

# Railway automatically provides PORT environment variable
# You can add other custom environment variables as needed
